{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "elamoudi",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "elamoudi" }],
  "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "elamoudi-cache" }],
  "durable_objects": {
    "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }],
  // next/image resizing through Cloudflare Images (replaces Vercel image optimization).
  "images": { "binding": "IMAGES" },
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "www.elamoudifurniture.com", "custom_domain": true },
    { "pattern": "elamoudifurniture.com", "custom_domain": true }
  ],
  "workers_dev": false
}
